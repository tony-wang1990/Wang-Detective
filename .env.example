# Web Admin Credentials
# 管理员账号默认 admin；口令无默认值、必填（至少 8 位），未设置时应用拒绝启动。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SSH 凭据加密密钥：无默认值、必填，必须与管理员口令不同。
# 可用 openssl rand -hex 32 生成。
OPS_SSH_SECRET_KEY=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=king_detective_bot
TELEGRAM_STARTUP_DELAY_SECONDS=20

# OpenAI/SiliconFlow API (Optional)

# Optional runtime hardening
# CORS 默认空（仅同源）。如需跨域，填可信来源列表（逗号分隔），不要填 *。
CORS_ALLOWED_ORIGINS=
